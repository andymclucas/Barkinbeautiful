# Barkin' Beautiful / GSOS — environment contract
#
# Copy to `.env` for local development. `.env` is gitignored — never commit real
# secrets. Production values live in the Render dashboard.
#
# Verified against actual usage in the codebase (see CLAUDE.md §9).

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app is broken or unsafe without these
# ─────────────────────────────────────────────────────────────────────────────

# MySQL / TiDB connection string. Required by drizzle.config.ts (throws without
# it) and server/db.ts. Note: server/db.ts fails SOFT — with no DATABASE_URL it
# logs a warning and runs with a null db, so the app boots but every query is a
# no-op. Always confirm this is set.
DATABASE_URL="mysql://user:password@host:4000/database?ssl={}"

# Signs session cookies (server/_core/env.ts -> cookieSecret) and client-portal
# session tokens (server/clientPortalSession.ts THROWS if unset). Use a long
# random string. Changing it logs everyone out.
JWT_SECRET="generate-a-long-random-string"

# Public base URL of this deployment, no trailing slash.
#
# CRITICAL: this builds every client-facing link — Pet Tracker SMS links, staff
# invitation emails, campaign unsubscribe links, Stripe checkout return URLs and
# the Twilio status callback. If it is unset, nine call sites silently fall back
# to the DECOMMISSIONED domain https://groomingsos-mqzfsvzv.manus.space and your
# customers receive dead links with no error logged anywhere.
# See CLAUDE.md §8.
VITE_APP_URL="https://staff.barkinbeautiful.com.au"

# Address that receives owner alerts — failed payments, system notifications
# (server/ownerNotification.ts, server/scheduledHandlers.ts). Falls back to the
# tenant's own email if unset.
OWNER_EMAIL="info@barkinbeautiful.com.au"

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — Resend
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Must be a Resend-verified sender on the barkinbeautiful.com.au domain.
# Defaults to noreply@barkinbeautiful.com.au if unset.
RESEND_FROM_EMAIL="noreply@barkinbeautiful.com.au"

# ─────────────────────────────────────────────────────────────────────────────
# SMS — Twilio
# ─────────────────────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+61..."

# Master switch for AUTOMATED outbound SMS: check-in tracker texts and the
# 3-stage appointment reminders. Must be the exact string "true" to enable.
#
# LEAVE THIS UNSET OR "false" OUTSIDE PRODUCTION. Enabling it locally against
# production data texts real clients and costs real money.
SMS_AUTOMATION_ENABLED="false"

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS — Stripe
# ─────────────────────────────────────────────────────────────────────────────

# Use a TEST key (sk_test_...) anywhere but production.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# Signing secret for the Stripe webhook endpoint. Must match the endpoint that
# is actually registered, or webhook verification silently rejects events.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# SCHEDULED JOBS
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token guarding the cron endpoints, driven by an external scheduler:
#   POST /api/scheduled/payment-retry
#   POST /api/scheduled/appointment-reminders
# Requests must send `Authorization: Bearer <CRON_SECRET>`. If unset, the guard
# cannot succeed and the jobs return 403.
CRON_SECRET="generate-a-long-random-string"

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────────────────────

# Server listen port. Defaults to 3000. Render sets this itself.
PORT="3000"

# ─────────────────────────────────────────────────────────────────────────────
# LEGACY — Manus platform. Safe to leave unset; the app is freestanding.
# ─────────────────────────────────────────────────────────────────────────────
#
# With VITE_APP_ID / OAUTH_SERVER_URL absent, server/_core/sdk.ts falls back to
# the self-hosted password app id ("groomigo-self-hosted-password") and auth runs
# entirely on local bcrypt + signed cookies. Setting these re-enables the old
# Manus OAuth path — don't, unless you are deliberately restoring it.
#
# VITE_APP_ID=""
# OAUTH_SERVER_URL=""
# OWNER_OPEN_ID=""
# VITE_OAUTH_PORTAL_URL=""          # client/src/const.ts, OAuth portal redirect
# BUILT_IN_FORGE_API_URL=""
# BUILT_IN_FORGE_API_KEY=""
# VITE_FRONTEND_FORGE_API_URL=""    # client/src/components/Map.tsx map tiles
# VITE_FRONTEND_FORGE_API_KEY=""
